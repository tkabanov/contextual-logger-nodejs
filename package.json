{
  "name": "@contextual-logger/nodejs",
  "version": "0.1.0",
  "description": "Framework-agnostic contextual logger with AsyncLocalStorage trace propagation, a NestJS adapter and optional Logtail/Sentry transports.",
  "keywords": [
    "logger",
    "context",
    "async-local-storage",
    "observability",
    "nestjs",
    "nodejs",
    "logtail",
    "sentry"
  ],
  "homepage": "https://github.com/tkabanov/contextual-logger-nodejs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkabanov/contextual-logger-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/tkabanov/contextual-logger-nodejs/issues"
  },
  "license": "MIT",
  "author": "Tim Kabanov",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "require": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./nestjs": {
      "types": "./dist/adapters/nestjs/index.d.ts",
      "require": "./dist/adapters/nestjs/index.js",
      "default": "./dist/adapters/nestjs/index.js"
    },
    "./transports/logtail": {
      "types": "./dist/transports/logtail/index.d.ts",
      "require": "./dist/transports/logtail/index.js",
      "default": "./dist/transports/logtail/index.js"
    },
    "./transports/sentry": {
      "types": "./dist/transports/sentry/index.d.ts",
      "require": "./dist/transports/sentry/index.js",
      "default": "./dist/transports/sentry/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "nestjs": [
        "dist/adapters/nestjs/index.d.ts"
      ],
      "transports/logtail": [
        "dist/transports/logtail/index.d.ts"
      ],
      "transports/sentry": [
        "dist/transports/sentry/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "husky || true",
    "lint": "eslint src test examples",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"{src,test,examples}/**/*.ts\" \"*.md\" --write",
    "format:check": "prettier \"{src,test,examples}/**/*.ts\" \"*.md\" --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@logtail/node": "^0.5.6",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@sentry/node": ">=8.0.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@logtail/node": {
      "optional": true
    },
    "@sentry/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@logtail/node": "^0.5.6",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^10.4.20",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@sentry/node": "^10.74.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.2",
    "semantic-release": "^24.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": "prettier --write"
  },
  "publishConfig": {
    "access": "public"
  }
}
