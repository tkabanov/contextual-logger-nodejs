{
  "name": "@contextual-logger/nodejs",
  "version": "0.1.0",
  "description": "Framework-agnostic contextual logger with AsyncLocalStorage trace propagation and a NestJS adapter.",
  "keywords": ["logger", "context", "async-local-storage", "observability", "nestjs", "nodejs"],
  "homepage": "https://github.com/tkabanov/contextual-logger-nodejs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkabanov/contextual-logger-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/tkabanov/contextual-logger-nodejs/issues"
  },
  "license": "MIT",
  "author": "Tim Kabanov",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "lint": "eslint --ext .ts src test --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"{src,test,examples}/**/*.ts\" \"*.md\" --write",
    "format:check": "prettier \"{src,test,examples}/**/*.ts\" \"*.md\" --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "release": "semantic-release"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@logtail/node": "^0.5.6"
  },
  "peerDependenciesMeta": {
    "@logtail/node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@logtail/node": "^0.5.6",
    "@nestjs/common": "^10.0.0",
    "@nestjs/testing": "^10.4.20",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.12",
    "typescript": "~5.5.4",
    "semantic-release": "^25.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": "prettier --write"
  },
  "publishConfig": {
    "access": "public"
  }
}

